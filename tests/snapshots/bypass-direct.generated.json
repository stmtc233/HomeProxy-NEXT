{
	"log": {
		"disabled": false,
		"level": "warn",
		"output": "__WORKDIR__/run/sing-box-c.log",
		"timestamp": true
	},
	"dns": {
		"servers": [
			{
				"tag": "default-dns",
				"type": "udp",
				"server": "223.5.5.5",
				"detour": "direct-out"
			},
			{
				"tag": "system-dns",
				"type": "local",
				"detour": "direct-out"
			},
			{
				"tag": "main-dns",
				"domain_resolver": {
					"server": "default-dns",
					"strategy": "ipv4_only"
				},
				"detour": "main-out",
				"type": "tcp",
				"server": "223.5.5.5"
			},
			{
				"tag": "china-dns",
				"domain_resolver": {
					"server": "default-dns",
					"strategy": "ipv4_only"
				},
				"detour": "direct-out",
				"type": "udp",
				"server": "114.114.114.114"
			}
		],
		"rules": [
			{
				"rule_set": "direct-domain",
				"action": "route",
				"server": "china-dns"
			},
			{
				"query_type": [
					64,
					65
				],
				"action": "reject"
			},
			{
				"query_type": [
					35
				],
				"domain_suffix": [
					"r.10086.cn",
					"10086.cn",
					"pub.3gppnetwork.org"
				],
				"action": "route",
				"server": "default-dns"
			},
			{
				"rule_set": "proxy-domain",
				"action": "route",
				"server": "main-dns"
			},
			{
				"rule_set": "geosite-cn",
				"action": "route",
				"server": "china-dns"
			},
			{
				"action": "evaluate",
				"server": "main-dns",
				"tag": "cn-fallback"
			},
			{
				"match_response": "cn-fallback",
				"rule_set": "geoip-cn",
				"action": "route",
				"server": "china-dns"
			}
		],
		"strategy": "ipv4_only",
		"optimistic": {
			"enabled": true,
			"timeout": "1d"
		},
		"timeout": "5s",
		"final": "main-dns"
	},
	"inbounds": [
		{
			"type": "direct",
			"tag": "dns-in",
			"listen": "127.0.0.1",
			"listen_port": 5333
		},
		{
			"type": "mixed",
			"tag": "mixed-in",
			"listen": "::",
			"listen_port": 5330,
			"set_system_proxy": false
		},
		{
			"type": "redirect",
			"tag": "redirect-in",
			"listen": "::",
			"listen_port": 5331
		},
		{
			"type": "tproxy",
			"tag": "tproxy-in",
			"listen": "::",
			"listen_port": 5332,
			"network": "udp"
		}
	],
	"outbounds": [
		{
			"type": "direct",
			"tag": "direct-out",
			"routing_mark": 100
		},
		{
			"type": "block",
			"tag": "block-out"
		},
		{
			"type": "direct",
			"tag": "main-out",
			"routing_mark": 100,
			"tcp_fast_open": true
		}
	],
	"route": {
		"rules": [
			{
				"inbound": "dns-in",
				"action": "hijack-dns"
			},
			{
				"action": "sniff"
			},
			{
				"rule_set": "direct-domain",
				"action": "route",
				"outbound": "direct-out"
			},
			{
				"action": "resolve",
				"strategy": "prefer_ipv4"
			},
			{
				"rule_set": "geoip-cn",
				"action": "route",
				"outbound": "direct-out"
			},
			{
				"action": "route-options",
				"override_address": "203.0.113.9",
				"override_port": 8443
			}
		],
		"rule_set": [
			{
				"type": "inline",
				"tag": "direct-domain",
				"rules": [
					{
						"domain_keyword": [
							"direct.example.com",
							"lan.example.org"
						]
					}
				]
			},
			{
				"type": "inline",
				"tag": "proxy-domain",
				"rules": [
					{
						"domain_keyword": [
							"proxy.example.com"
						]
					}
				]
			},
			{
				"type": "remote",
				"tag": "geoip-cn",
				"format": "binary",
				"url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
				"update_interval": "24h",
				"http_client": "hp-main-out"
			},
			{
				"type": "remote",
				"tag": "geosite-cn",
				"format": "binary",
				"url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs",
				"update_interval": "24h",
				"http_client": "hp-main-out"
			}
		],
		"auto_detect_interface": true,
		"default_domain_resolver": {
			"server": "default-dns",
			"strategy": "prefer_ipv4"
		},
		"final": "main-out"
	},
	"services": [
		{
			"type": "api",
			"listen": "0.0.0.0",
			"listen_port": 9090,
			"dashboard": {
				"enabled": true,
				"path": "__WORKDIR__/run/dashboard/web",
				"http_client": "hp-main-out"
			}
		}
	],
	"http_clients": [
		{
			"tag": "hp-main-out",
			"detour": "main-out"
		}
	],
	"experimental": {
		"cache_file": {
			"enabled": true,
			"path": "/etc/homeproxy/cache.db",
			"store_dns": true
		}
	},
	"$schema": "https://sing-box.sagernet.org/schema.json"
}
