{
	"log": {
		"disabled": false,
		"level": "error",
		"output": "__WORKDIR__/run/sing-box-c.log",
		"timestamp": true
	},
	"dns": {
		"servers": [
			{
				"tag": "default-dns",
				"type": "udp",
				"server": "223.5.5.5",
				"detour": "direct-out"
			},
			{
				"tag": "system-dns",
				"type": "local",
				"detour": "direct-out"
			},
			{
				"tag": "Remote DNS",
				"type": "tcp",
				"server": "8.8.8.8",
				"detour": "Proxy"
			},
			{
				"tag": "China DNS",
				"type": "udp",
				"server": "223.5.5.5",
				"detour": "direct-out"
			}
		],
		"rules": [
			{
				"query_type": [
					64,
					65
				],
				"action": "reject"
			},
			{
				"clash_mode": "Direct",
				"action": "route",
				"server": "China DNS"
			},
			{
				"clash_mode": "Global",
				"action": "route",
				"server": "Remote DNS"
			},
			{
				"rule_set": [
					"geosite-ads"
				],
				"clash_mode": "Rule",
				"action": "reject"
			},
			{
				"type": "logical",
				"mode": "and",
				"rules": [
					{
						"type": "logical",
						"mode": "or",
						"rules": [
							{
								"clash_mode": "Rule"
							},
							{
								"clash_mode": "RuleAllowAds"
							}
						]
					},
					{
						"rule_set": [
							"geosite-cn"
						]
					}
				],
				"action": "route",
				"server": "China DNS"
			}
		],
		"strategy": "prefer_ipv4",
		"final": "Remote DNS"
	},
	"inbounds": [
		{
			"type": "direct",
			"tag": "dns-in",
			"listen": "127.0.0.1",
			"listen_port": 5333
		},
		{
			"type": "mixed",
			"tag": "mixed-in",
			"listen": "::",
			"listen_port": 5330,
			"set_system_proxy": false
		},
		{
			"type": "redirect",
			"tag": "redirect-in",
			"listen": "::",
			"listen_port": 5331
		},
		{
			"type": "tproxy",
			"tag": "tproxy-in",
			"listen": "::",
			"listen_port": 5332,
			"network": "udp"
		}
	],
	"outbounds": [
		{
			"type": "direct",
			"tag": "direct-out",
			"routing_mark": 100
		},
		{
			"type": "block",
			"tag": "block-out"
		},
		{
			"type": "urltest",
			"tag": "Auto",
			"outbounds": [
				"hk",
				"jp"
			],
			"url": "https://www.gstatic.com/generate_204",
			"interval": "180s",
			"tolerance": 50,
			"idle_timeout": "1800s"
		},
		{
			"type": "selector",
			"tag": "Proxy",
			"outbounds": [
				"Auto",
				"hk",
				"jp",
				"direct-out"
			],
			"default": "Auto"
		},
		{
			"type": "shadowsocks",
			"tag": "hk",
			"routing_mark": 100,
			"server": "hk.example.com",
			"server_port": 8388,
			"password": "secret",
			"method": "aes-128-gcm"
		},
		{
			"type": "trojan",
			"tag": "jp",
			"routing_mark": 100,
			"server": "jp.example.com",
			"server_port": 443,
			"password": "secret",
			"tls": {
				"enabled": true,
				"server_name": "jp.example.com"
			}
		}
	],
	"route": {
		"rules": [
			{
				"inbound": "dns-in",
				"action": "hijack-dns"
			},
			{
				"action": "sniff"
			},
			{
				"clash_mode": "Direct",
				"action": "route",
				"outbound": "direct-out"
			},
			{
				"clash_mode": "Global",
				"action": "route",
				"outbound": "Proxy"
			},
			{
				"rule_set": [
					"geosite-ads"
				],
				"clash_mode": "Rule",
				"action": "reject"
			},
			{
				"type": "logical",
				"mode": "and",
				"rules": [
					{
						"type": "logical",
						"mode": "or",
						"rules": [
							{
								"clash_mode": "Rule"
							},
							{
								"clash_mode": "RuleAllowAds"
							}
						]
					},
					{
						"rule_set": [
							"geosite-cn"
						]
					}
				],
				"action": "route",
				"outbound": "direct-out"
			},
			{
				"type": "logical",
				"mode": "or",
				"rules": [
					{
						"clash_mode": "Rule"
					},
					{
						"clash_mode": "RuleAllowAds"
					}
				],
				"action": "resolve"
			},
			{
				"type": "logical",
				"mode": "and",
				"rules": [
					{
						"type": "logical",
						"mode": "or",
						"rules": [
							{
								"clash_mode": "Rule"
							},
							{
								"clash_mode": "RuleAllowAds"
							}
						]
					},
					{
						"rule_set": [
							"geoip-cn"
						]
					}
				],
				"action": "route",
				"outbound": "direct-out"
			}
		],
		"rule_set": [
			{
				"type": "remote",
				"tag": "geoip-cn",
				"format": "binary",
				"url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
				"update_interval": "1d",
				"http_client": "hp-Proxy",
				"initial_path": "__WORKDIR__/resources/geoip_cn.srs"
			},
			{
				"type": "remote",
				"tag": "geosite-cn",
				"format": "binary",
				"url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs",
				"update_interval": "1d",
				"http_client": "hp-Proxy",
				"initial_path": "__WORKDIR__/resources/geosite_cn.srs"
			},
			{
				"type": "remote",
				"tag": "geosite-ads",
				"format": "binary",
				"url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs",
				"update_interval": "1d",
				"http_client": "hp-Proxy",
				"initial_path": "__WORKDIR__/resources/geosite_ads.srs"
			}
		],
		"auto_detect_interface": true,
		"default_domain_resolver": {
			"server": "default-dns"
		},
		"final": "Proxy"
	},
	"http_clients": [
		{
			"tag": "hp-Proxy",
			"detour": "Proxy"
		}
	],
	"experimental": {
		"cache_file": {
			"enabled": true,
			"path": "/etc/homeproxy/cache.db"
		},
		"clash_api": {
		}
	},
	"$schema": "https://sing-box.sagernet.org/schema.json"
}
