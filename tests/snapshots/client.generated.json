{
	"log": {
		"disabled": false,
		"level": "error",
		"output": "__WORKDIR__/run/sing-box-c.log",
		"timestamp": true
	},
	"dns": {
		"servers": [
			{
				"tag": "default-dns",
				"type": "udp",
				"server": "223.5.5.5"
			},
			{
				"tag": "system-dns",
				"type": "local"
			}
		],
		"rules": [
			{
				"clash_mode": "Rule",
				"action": "route",
				"server": "default-dns"
			}
		],
		"final": "default-dns"
	},
	"inbounds": [
		{
			"type": "direct",
			"tag": "dns-in",
			"listen": "127.0.0.1",
			"listen_port": 5333
		},
		{
			"type": "mixed",
			"tag": "mixed-in",
			"listen": "::",
			"listen_port": 5330,
			"set_system_proxy": false
		},
		{
			"type": "tun",
			"tag": "tun-in",
			"interface_name": "singtun0",
			"address": [
				"172.19.0.1/30"
			],
			"mtu": 9000,
			"auto_route": false,
			"stack": "system"
		}
	],
	"outbounds": [
		{
			"type": "direct",
			"tag": "direct-out"
		},
		{
			"type": "block",
			"tag": "block-out"
		},
		{
			"type": "urltest",
			"tag": "auto",
			"outbounds": [
				"anytls",
				"vless-reality-ws",
				"vmess-http",
				"trojan-grpc",
				"ss",
				"hy2",
				"snell",
				"http",
				"socks",
				"shadowtls"
			],
			"url": "https://www.gstatic.com/generate_204",
			"interval": "180s",
			"tolerance": 50,
			"idle_timeout": "1800s"
		},
		{
			"type": "anytls",
			"tag": "anytls",
			"server": "a.example.com",
			"server_port": 443,
			"password": "secret",
			"idle_session_check_interval": "30s",
			"idle_session_timeout": "30s",
			"tls": {
				"enabled": true,
				"server_name": "a.example.com",
				"insecure": false
			}
		},
		{
			"type": "vless",
			"tag": "vless-reality-ws",
			"server": "b.example.com",
			"server_port": 443,
			"uuid": "3af88561-9c69-4b19-8f7e-f08d580bc339",
			"flow": "xtls-rprx-vision",
			"packet_encoding": "xudp",
			"tls": {
				"enabled": true,
				"server_name": "b.example.com",
				"utls": {
					"enabled": true,
					"fingerprint": "chrome"
				},
				"reality": {
					"enabled": true,
					"public_key": "4UAg690QziXeelpUJoAmXiim0gfQESSiJkNfvF-o8Uw",
					"short_id": "abcd"
				}
			},
			"transport": {
				"type": "ws",
				"path": "/ws?ed=2048",
				"headers": {
					"Host": "b.example.com"
				}
			}
		},
		{
			"type": "vmess",
			"tag": "vmess-http",
			"server": "c.example.com",
			"server_port": 80,
			"uuid": "3af88561-9c69-4b19-8f7e-f08d580bc339",
			"security": "auto",
			"global_padding": true,
			"packet_encoding": "packetaddr",
			"transport": {
				"type": "http",
				"host": "c.example.com",
				"path": "/path",
				"method": "GET"
			}
		},
		{
			"type": "trojan",
			"tag": "trojan-grpc",
			"server": "d.example.com",
			"server_port": 443,
			"password": "secret",
			"tls": {
				"enabled": true,
				"server_name": "d.example.com",
				"min_version": "1.2",
				"max_version": "1.3",
				"handshake_timeout": "15s",
				"cipher_suites": "TLS_AES_128_GCM_SHA256"
			},
			"transport": {
				"type": "grpc",
				"service_name": "gs",
				"permit_without_stream": true
			}
		},
		{
			"type": "shadowsocks",
			"tag": "ss",
			"server": "e.example.com",
			"server_port": 8388,
			"password": "secret",
			"method": "aes-256-gcm",
			"multiplex": {
				"enabled": true,
				"protocol": "h2mux",
				"max_connections": 4,
				"padding": true
			},
			"udp_over_tcp": {
				"enabled": true,
				"version": 2
			}
		},
		{
			"type": "hysteria2",
			"tag": "hy2",
			"server": "f.example.com",
			"server_port": 443,
			"server_ports": "20000:30000",
			"password": "secret",
			"hop_interval": "30s",
			"up_mbps": 100,
			"down_mbps": 500,
			"obfs": {
				"type": "salamander",
				"password": "obfspass"
			},
			"bbr_profile": "conservative",
			"tls": {
				"enabled": true,
				"server_name": "f.example.com"
			}
		},
		{
			"type": "snell",
			"tag": "snell",
			"server": "g.example.com",
			"server_port": 443,
			"psk": "psk123456789012",
			"userkey": "ukey",
			"reuse": true,
			"obfs_mode": "http",
			"obfs_host": "bing.com",
			"version": 4
		},
		{
			"type": "http",
			"tag": "http",
			"server": "h.example.com",
			"server_port": 8080,
			"username": "u",
			"password": "p"
		},
		{
			"type": "socks",
			"tag": "socks",
			"server": "i.example.com",
			"server_port": 1080,
			"username": "u",
			"password": "p",
			"version": "5"
		},
		{
			"type": "shadowtls",
			"tag": "shadowtls",
			"server": "j.example.com",
			"server_port": 443,
			"password": "secret",
			"version": 3,
			"tls": {
				"enabled": true,
				"server_name": "j.example.com"
			}
		}
	],
	"route": {
		"rules": [
			{
				"inbound": "dns-in",
				"action": "hijack-dns"
			},
			{
				"action": "sniff"
			},
			{
				"clash_mode": "Rule",
				"action": "route",
				"outbound": "auto"
			}
		],
		"auto_detect_interface": true,
		"default_domain_resolver": {
			"server": "default-dns"
		},
		"final": "auto"
	},
	"experimental": {
		"cache_file": {
			"enabled": true,
			"path": "/etc/homeproxy/cache.db"
		},
		"clash_api": {
			"default_mode": "Rule"
		}
	},
	"$schema": "https://sing-box.sagernet.org/schema.json"
}
