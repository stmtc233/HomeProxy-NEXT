# SPDX-License-Identifier: GPL-2.0-only
#
# Regression fixture for routing WITHOUT a default outbound.
#
# Every routing rule names its own outbound and the mode leaves its default
# outbound unset (it was 'nil' before the routing modes). The generator used
# to select its config branch by asking whether default_outbound was
# non-empty, so this configuration fell through the DNS,
# outbound and route branches alike and produced a config containing none of
# the user's DNS servers, nodes, rules or rule-sets. With the two built-in
# DNS servers (default-dns / system-dns) still emitted, sing-box 1.14 then
# refused to start at all:
#
#   ERROR missing `route.default_domain_resolver` or `domain_resolver` in
#   dial fields ... FATAL ... sing-box 1.14.0
#
# and generate_client.uc deleted the config instead of moving it into place,
# so the user got no sing-box.json and no log.

config homeproxy 'config'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '0'
	option log_level 'error'

config homeproxy 'routing'
	option default_mode 'm_rule'
	option default_outbound_dns 'default-dns'
	option sniff_override '1'

# No default outbound: the point of this fixture. Each routing_rule below
# picks its own.
config routing_mode 'm_rule'
	option enabled '1'
	option label 'Rule'
	option default_server 'default-dns'

config homeproxy 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option tproxy_port '5332'
	option self_mark '100'
	option ntp_server 'nil'

# A node addressed by domain, so the generated outbound carries dial fields
# that sing-box 1.14 requires a resolver for.
config node 'n_hk'
	option label 'hk'
	option type 'trojan'
	option address 'hk.example.com'
	option port '443'
	option password 'secret'
	option tls '1'
	option tls_sni 'hk.example.com'

config node 'n_sg'
	option label 'sg'
	option type 'vless'
	option address 'sg.example.com'
	option port '443'
	option uuid '3af88561-9c69-4b19-8f7e-f08d580bc339'
	option tls '1'
	option tls_sni 'sg.example.com'

# Hysteria2 through a realm: no address/port, the outbound carries `realm` instead.
config node 'n_realm'
	option label 'realm'
	option type 'hysteria2'
	option password 'secret'
	option hysteria_realm '1'
	option hysteria_realm_server_url 'https://realm.example.com'
	option hysteria_realm_id 'hp-test'
	option hysteria_realm_token 'realm-token'
	list hysteria_realm_stun_servers 'stun.example.com:3478'
	option hysteria_realm_ip_version '4'
	option hysteria_realm_port_mapping '1'
	option tls '1'
	option tls_sni 'realm.example.com'

# urltest group: exercises the urltest_nodes back-fill loop as well
config routing_node 'Routing_Node_Proxy'
	option enabled '1'
	option label 'Routing_Node_Proxy'
	option node 'urltest'
	list urltest_nodes 'n_hk'
	list urltest_nodes 'n_sg'
	list urltest_nodes 'n_realm'
	option urltest_url 'https://www.gstatic.com/generate_204'
	option urltest_interval '10m'

# A user-defined DNS server, resolved through the built-in system resolver.
config dns_server 'DNS_Server_Proxy'
	option enabled '1'
	option label 'DNS_Server_Proxy'
	option type 'tls'
	option server '8.8.8.8'
	option address_resolver 'system-dns'
	option address_strategy 'ipv4_only'
	option outbound 'Routing_Node_Proxy'

# Local-only server types: hosts has no dial fields, dhcp takes the interface.
config dns_server 'DNS_Server_Hosts'
	option enabled '1'
	option label 'DNS_Server_Hosts'
	option type 'hosts'
	list hosts_predefined 'hosts-marker.example.com 192.168.1.10 fd00::10'

config dns_server 'DNS_Server_Dhcp'
	option enabled '1'
	option label 'DNS_Server_Dhcp'
	option type 'dhcp'

# evaluate then respond: the response saved by the first rule is returned as is.
config dns_rule 'DNS_Rule_Evaluate'
	option routing_mode 'm_rule'
	option enabled '1'
	option label 'DNS_Rule_Evaluate'
	option mode 'default'
	list domain_suffix 'dns-respond-marker.example.com'
	option action 'evaluate'
	option server 'DNS_Server_Proxy'

config dns_rule 'DNS_Rule_Respond'
	option routing_mode 'm_rule'
	option enabled '1'
	option label 'DNS_Rule_Respond'
	option mode 'default'
	list domain_suffix 'dns-respond-marker.example.com'
	option action 'respond'

config dns_rule 'DNS_Rule_Proxy'
	option routing_mode 'm_rule'
	option enabled '1'
	option label 'DNS_Rule_Proxy'
	option mode 'default'
	list domain_suffix 'dns-rule-marker.example.com'
	list rule_set 'rs_cn'
	option action 'route'
	option server 'DNS_Server_Proxy'

config ruleset 'rs_cn'
	option enabled '1'
	option label 'rs-cn'
	option type 'remote'
	option format 'binary'
	option url 'https://example.com/geoip-cn.srs'
	option update_interval '24h'
	option outbound 'Routing_Node_Proxy'

config routing_rule 'Routing_Rule_Proxy'
	option routing_mode 'm_rule'
	option enabled '1'
	option label 'Routing_Rule_Proxy'
	option mode 'default'
	list domain_suffix 'routing-rule-marker.example.com'
	list rule_set 'rs_cn'
	option action 'route'
	option outbound 'Routing_Node_Proxy'
