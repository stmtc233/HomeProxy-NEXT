# SPDX-License-Identifier: GPL-2.0-only
#
# Field-mapping fixture for routing_rule and dns_rule: every match field and
# every action-specific option the LuCI forms offer is set at least once, so
# the golden snapshot (tests/snapshots/rules.generated.json) locks how each
# UCI option reaches the sing-box config.
#
# __RULESET_DIR__ is substituted by tests/ucode/test_generators.sh with a
# directory holding a real compiled .srs file.

config homeproxy 'config'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '1'
	option log_level 'error'

config homeproxy 'routing'
	option default_outbound 'direct-out'
	option sniff_override '1'

config homeproxy 'dns'
	option default_server 'ds_main'

config homeproxy 'infra'
	option ntp_server 'time.apple.com'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option tproxy_port '5332'
	option self_mark '100'
	option tproxy_mark '101'

config dns_server 'ds_main'
	option enabled '1'
	option label 'ds-main'
	option type 'udp'
	option server '8.8.8.8'

config ruleset 'rs_local'
	option enabled '1'
	option label 'rs-local'
	option type 'local'
	option format 'binary'
	option path '__RULESET_DIR__/test.srs'

# every match field of a routing rule
config routing_rule 'rr_match'
	option enabled '1'
	option label 'rr-match'
	option mode 'default'
	option ip_version '4'
	list protocol 'quic'
	option client 'chromium'
	option network 'udp'
	list user 'nobody'
	list rule_set 'rs_local'
	option rule_set_ip_cidr_match_source '1'
	option invert '1'
	list domain 'full.example.com'
	list domain_suffix 'suffix.example.com'
	list domain_keyword 'keyword'
	list domain_regex '^regex\.example\.com$'
	list source_ip_cidr '192.168.1.0/24'
	option source_ip_is_private '1'
	list ip_cidr '203.0.113.0/24'
	option ip_is_private '1'
	list source_mac_address '00:11:22:33:44:55'
	list source_hostname 'laptop'
	list source_port '12345'
	list source_port_range '10000:20000'
	list port '443'
	list port_range '8000:9000'
	list process_name 'curl'
	list process_path '/usr/bin/curl'
	list process_path_regex '^/usr/bin/.*$'
	option action 'route'
	option outbound 'direct-out'

config routing_rule 'rr_options'
	option enabled '1'
	option label 'rr-options'
	list domain_suffix 'options.example.com'
	option action 'route-options'
	option override_address '198.51.100.1'
	option override_port '8443'
	option udp_disable_domain_unmapping '1'
	option udp_connect '1'
	option udp_timeout '30s'
	option tls_fragment '1'
	option tls_fragment_fallback_delay '500'
	option tls_spoof 'spoof.example.com'
	option tls_spoof_method 'wrong-sequence'

# tls_record_fragment is mutually exclusive with tls_fragment
config routing_rule 'rr_record_fragment'
	option enabled '1'
	option label 'rr-record-fragment'
	list domain_suffix 'record.example.com'
	option action 'route'
	option outbound 'direct-out'
	option tls_record_fragment '1'

# both fragment modes on a route action: sing-box applies them together
config routing_rule 'rr_both_fragments'
	option enabled '1'
	option label 'rr-both-fragments'
	list domain_suffix 'both.example.com'
	option action 'route'
	option outbound 'direct-out'
	option tls_fragment '1'
	option tls_fragment_fallback_delay '300'
	option tls_record_fragment '1'

# the same pair on route-options is rejected by sing-box, so a config saved
# that way keeps tls_record_fragment and drops tls_fragment
config routing_rule 'rr_both_fragments_options'
	option enabled '1'
	option label 'rr-both-fragments-options'
	list domain_suffix 'both-options.example.com'
	option action 'route-options'
	option tls_fragment '1'
	option tls_fragment_fallback_delay '300'
	option tls_record_fragment '1'

config routing_rule 'rr_resolve'
	option enabled '1'
	option label 'rr-resolve'
	list domain_suffix 'resolve.example.com'
	option action 'resolve'
	option resolve_server 'ds_main'
	option resolve_strategy 'prefer_ipv4'
	option resolve_disable_cache '1'
	option resolve_disable_optimistic_cache '1'
	option resolve_rewrite_ttl '60'
	option resolve_timeout '5s'
	option resolve_client_subnet '198.51.100.0/24'

config routing_rule 'rr_reject'
	option enabled '1'
	option label 'rr-reject'
	list domain_suffix 'reject.example.com'
	option action 'reject'
	option reject_method 'default'
	option reject_no_drop '1'

config routing_rule 'rr_disabled'
	option enabled '0'
	option label 'rr-disabled'
	list domain_suffix 'disabled.example.com'
	option action 'route'
	option outbound 'direct-out'

# every match field of a DNS rule; the legacy ip_cidr / ip_is_private filter
# on a route action gets wrapped into a generated evaluate rule
config dns_rule 'dr_match'
	option enabled '1'
	option label 'dr-match'
	option mode 'default'
	option ip_version '6'
	list query_type 'A'
	list query_type 'AAAA'
	option network 'udp'
	list protocol 'dns'
	list user 'nobody'
	list rule_set 'rs_local'
	option rule_set_ip_cidr_match_source '1'
	option invert '1'
	list domain 'full.example.com'
	list domain_suffix 'suffix.example.com'
	list domain_keyword 'keyword'
	list domain_regex '^regex\.example\.com$'
	list source_ip_cidr '192.168.1.0/24'
	option source_ip_is_private '1'
	list ip_cidr '203.0.113.0/24'
	option ip_is_private '1'
	list source_mac_address '00:11:22:33:44:55'
	list source_hostname 'laptop'
	option query_client_subnet '198.51.100.0/24'
	option query_dnssec '1'
	list source_port '12345'
	list source_port_range '10000:20000'
	list port '53'
	list port_range '5000:6000'
	list process_name 'curl'
	list process_path '/usr/bin/curl'
	list process_path_regex '^/usr/bin/.*$'
	option action 'route'
	option server 'ds_main'
	option dns_disable_cache '1'
	option disable_optimistic_cache '1'
	option rewrite_ttl '60'
	option client_subnet '198.51.100.0/24'
	option dns_timeout '5s'

config dns_rule 'dr_evaluate'
	option enabled '1'
	option label 'dr-evaluate'
	list domain_suffix 'evaluate.example.com'
	option action 'evaluate'
	option server 'ds_main'
	option evaluate_tag 'eval-tag'
	option speculative '1'

config dns_rule 'dr_response'
	option enabled '1'
	option label 'dr-response'
	list domain_suffix 'evaluate.example.com'
	option match_response 'eval-tag'
	option response_rcode 'NOERROR'
	list response_answer 'evaluate.example.com. IN A 203.0.113.1'
	list response_ns 'example.com. IN NS ns.example.com.'
	list response_extra 'ns.example.com. IN A 203.0.113.2'
	list ip_cidr '203.0.113.0/24'
	option action 'route'
	option server 'ds_main'
	option race '1'
	option remove_client_subnet '1'

config dns_rule 'dr_predefined'
	option enabled '1'
	option label 'dr-predefined'
	list domain_suffix 'predefined.example.com'
	option action 'predefined'
	option predefined_rcode 'NOERROR'
	list predefined_answer 'predefined.example.com. IN A 203.0.113.3'
	list predefined_ns 'example.com. IN NS ns.example.com.'
	list predefined_extra 'ns.example.com. IN A 203.0.113.4'

config dns_rule 'dr_reject'
	option enabled '1'
	option label 'dr-reject'
	list domain_suffix 'reject.example.com'
	option action 'reject'
	option reject_method 'default'
	option reject_no_drop '1'
