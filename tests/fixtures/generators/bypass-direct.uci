# SPDX-License-Identifier: GPL-2.0-only
#
# Coverage fixture for bypass_mainland_china with a single (non-urltest)
# main node: a direct node carrying an override (the main route-options
# rule), the same node for UDP, a custom China DNS, cn_ip_fallback, the
# direct/proxy domain lists (bypass-direct.direct_list.txt and
# bypass-direct.proxy_list.txt next to this file), the global DNS cache
# options and the dashboard downloading through main-out.

config homeproxy 'config'
	option routing_mode 'bypass_mainland_china'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '0'
	option log_level 'warn'
	option main_node 'n_main'
	option main_udp_node 'same'
	option dns_server 'wan'
	option china_dns_server '114.114.114.114'
	option cn_ip_fallback '1'
	option dashboard '1'

config homeproxy 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option tproxy_port '5332'
	option self_mark '100'
	option ntp_server 'nil'

config homeproxy 'dns'
	option optimistic_cache '1'
	option optimistic_timeout '1d'
	option dns_timeout '5'
	option cache_file_store_dns '1'

config node 'n_main'
	option label 'main-direct'
	option type 'direct'
	option override_address '203.0.113.9'
	option override_port '8443'
	option tcp_fast_open '1'
