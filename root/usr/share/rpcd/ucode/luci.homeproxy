'use strict';

import { access, error, lstat, popen, readfile, rename, writefile, unlink } from 'fs';
import { cursor } from 'uci';

import { isBinary, isValidPEM, listPlugins, PLUGIN_NAME_RE } from '/etc/homeproxy/scripts/homeproxy.uc';

/* Kanged from ucode/luci */
function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function hasKernelModule(kmod) {
	return (system(sprintf('[ -e "/lib/modules/$(uname -r)"/%s ]', shellquote(kmod))) === 0);
}

const HP_DIR = '/etc/homeproxy';
const RUN_DIR = '/var/run/homeproxy';

/* Resource lists the status page may query/update; single source for the two
   methods below (the update path also validates the type against it to keep
   path traversal out). */
const RESOURCE_TYPES = ['china_ip4', 'china_ip6', 'gfw_list', 'china_list', 'geoip_cn', 'geosite_cn'];

/* Configuration backup: infra holds internal ports/marks and migration is a
   one-shot flag, neither belongs in a portable backup. */
const BACKUP_FORMAT = 'homeproxy-backup';
const BACKUP_SKIP = ['infra', 'migration'];
const BACKUP_TMPFILE = '/tmp/homeproxy_import.tmp';
const BACKUP_NAME_RE = /^[A-Za-z0-9_]+$/;

/* Custom plugins: the files are the state (<name>.uc on, <name>.uc.disabled
   off), so editing them over SSH and on the plugin page stay in sync. */
const PLUGIN_DIR = `${HP_DIR}/custom`;
const PLUGIN_MAX_SIZE = 256 * 1024;

function pluginFile(name) {
	if (!match(name, PLUGIN_NAME_RE))
		return null;
	for (let p in listPlugins(PLUGIN_DIR))
		if (p.name === name)
			return `${PLUGIN_DIR}/${p.file}`;
	return '';
}

function backupIsTrue(v) {
	return (v === true || v === 1 || v === '1' || v === 'true');
}

/* Nodes and subscriptions live in the `node` sections and the `subscription`
   section; everything pointing at them must go when those are left out. */
function backupIsNodeSection(name, type) {
	return (type === 'node' || name === 'subscription');
}

function backupStripNodeRefs(section, node_names) {
	const isNodeRef = (v) => (v in node_names) || substr(v, 0, 4) === 'sub_';

	if (section.type !== 'routing_node')
		return;

	const opts = section.options;
	if (type(opts.node) === 'string' && !(opts.node in ['urltest', 'selector']) && isNodeRef(opts.node))
		delete opts.node;
	for (let list_opt in ['urltest_nodes', 'selector_nodes']) {
		if (type(opts[list_opt]) === 'array') {
			opts[list_opt] = filter(opts[list_opt], (v) => !isNodeRef(v));
			if (!length(opts[list_opt]))
				delete opts[list_opt];
		}
	}
	if (type(opts.selector_default) === 'string' && isNodeRef(opts.selector_default))
		delete opts.selector_default;
}

const methods = {
	plugin_list: {
		call: function() {
			const status = {};
			for (let kind in ['client', 'server']) {
				const raw = readfile(`${RUN_DIR}/plugins-${kind}.json`);
				try {
					status[kind] = raw ? json(raw) : null;
				} catch (e) {
					status[kind] = null;
				}
			}

			return { plugins: listPlugins(PLUGIN_DIR), status };
		}
	},

	plugin_read: {
		args: { name: 'name' },
		call: function(req) {
			const file = pluginFile(req.args?.name);
			if (!file)
				return { content: null, error: (file === null) ? 'illegal name' : 'no such plugin' };

			return { content: readfile(file) };
		}
	},

	plugin_write: {
		args: { name: 'name', content: 'content' },
		call: function(req) {
			const name = req.args?.name;
			let file = pluginFile(name);
			if (file === null)
				return { result: false, error: 'illegal name' };

			let content = req.args?.content;
			if (type(content) !== 'string' || length(content) > PLUGIN_MAX_SIZE)
				return { result: false, error: 'content missing or too large' };
			content = replace(content, /\r\n?/g, '\n');
			if (!match(content, /\n$/))
				content += '\n';

			/* compile only (nothing runs): a syntax error is shown right away
			   instead of being found at the next start */
			system(`mkdir -p ${PLUGIN_DIR}`);
			const tmp = `${PLUGIN_DIR}/.${name}.tmp`;
			writefile(tmp, content);
			try {
				loadfile(tmp);
			} catch (e) {
				unlink(tmp);
				return { result: false, error: replace(e.message, tmp, `${name}.uc`) };
			}

			/* a new plugin starts enabled */
			if (!file)
				file = `${PLUGIN_DIR}/${name}.uc`;
			if (!rename(tmp, file)) {
				unlink(tmp);
				return { result: false, error: error() };
			}

			return { result: true };
		}
	},

	plugin_remove: {
		args: { name: 'name' },
		call: function(req) {
			const file = pluginFile(req.args?.name);
			if (!file)
				return { result: false, error: (file === null) ? 'illegal name' : 'no such plugin' };

			return unlink(file) ? { result: true } : { result: false, error: error() };
		}
	},

	plugin_set_enabled: {
		args: { name: 'name', enabled: true },
		call: function(req) {
			const name = req.args?.name;
			const file = pluginFile(name);
			if (!file)
				return { result: false, error: (file === null) ? 'illegal name' : 'no such plugin' };

			const target = `${PLUGIN_DIR}/${name}.uc${req.args?.enabled ? '' : '.disabled'}`;
			if (file === target)
				return { result: true };
			if (access(target))
				return { result: false, error: 'both an enabled and a disabled copy exist' };

			return rename(file, target) ? { result: true } : { result: false, error: error() };
		}
	},

	certificate_write: {
		args: { filename: 'filename' },
		call: function(req) {
			const writeCertificate = (filename, priv) => {
				const tmpcert = '/tmp/homeproxy_certificate.tmp';
				const filestat = lstat(tmpcert);

				if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'empty certificate file' };
				}

				let filecontent = readfile(tmpcert);
				if (isBinary(filecontent)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'illegal file type: binary' };
				}

				/* Validate the PEM structure before storing it */
				if (!isValidPEM(filecontent, priv)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'this does not look like a correct PEM file' };
				}

				/* Sanitize certificate */
				filecontent = trim(filecontent);
				filecontent = replace(filecontent, /\r\n?/g, '\n');
				if (!match(filecontent, /\n$/))
					filecontent += '\n';

				system(`mkdir -p ${HP_DIR}/certs`);
				writefile(`${HP_DIR}/certs/${filename}.pem`, filecontent);
				system(`rm -f ${tmpcert}`);

				return { result: true };
			};

			const filename = req.args?.filename;
			switch (filename) {
			case 'client_ca':
			case 'server_publickey':
			/* the ECH config the client form uploads (node.js uploadCertificate) */
			case 'client_ech_conf':
				return writeCertificate(filename, false);
				break;
			case 'server_privatekey':
				return writeCertificate(filename, true);
				break;
			default:
				return { result: false, error: 'illegal cerificate filename' };
				break;
			}
		}
	},

	config_export: {
		args: { include_nodes: true },
		call: function(req) {
			const include_nodes = backupIsTrue(req.args?.include_nodes);
			const uci = cursor();
			uci.load('homeproxy');

			let node_names = {};
			uci.foreach('homeproxy', 'node', (s) => {
				node_names[s['.name']] = true;
			});

			let sections = [];
			uci.foreach('homeproxy', null, (s) => {
				const name = s['.name'], sectype = s['.type'];

				if (name in BACKUP_SKIP)
					return;
				if (!include_nodes && backupIsNodeSection(name, sectype))
					return;

				let options = {};
				for (let k, v in s) {
					if (substr(k, 0, 1) === '.')
						continue;
					options[k] = v;
				}

				const section = { name, type: sectype, options };
				if (!include_nodes)
					backupStripNodeRefs(section, node_names);
				push(sections, section);
			});

			return {
				result: true,
				backup: {
					format: BACKUP_FORMAT,
					version: 1,
					created: time(),
					include_nodes,
					sections
				}
			};
		}
	},

	config_import: {
		args: { include_nodes: true },
		call: function(req) {
			const fail = (msg) => {
				unlink(BACKUP_TMPFILE);
				return { result: false, error: msg };
			};

			const filestat = lstat(BACKUP_TMPFILE);
			if (!filestat || filestat.type !== 'file' || filestat.size <= 0)
				return fail('empty backup file');

			let backup;
			try {
				backup = json(readfile(BACKUP_TMPFILE));
			} catch (e) {
				backup = null;
			}
			unlink(BACKUP_TMPFILE);

			if (type(backup) !== 'object' || backup.format !== BACKUP_FORMAT || type(backup.sections) !== 'array')
				return { result: false, error: 'not a homeproxy backup file' };

			/* Only take nodes when the user asks for it and the file carries them */
			const import_nodes = backupIsTrue(req.args?.include_nodes) && backupIsTrue(backup.include_nodes);

			/* Validate and normalise every section before touching the config */
			let sections = [], seen = {};
			for (let s in backup.sections) {
				if (type(s) !== 'object' || type(s.name) !== 'string' || type(s.type) !== 'string' ||
				    type(s.options) !== 'object')
					return { result: false, error: 'malformed section entry' };
				if (!match(s.name, BACKUP_NAME_RE) || !match(s.type, BACKUP_NAME_RE))
					return { result: false, error: 'illegal section name or type' };
				if (s.name in BACKUP_SKIP || s.name in seen)
					continue;
				seen[s.name] = true;
				if (!import_nodes && backupIsNodeSection(s.name, s.type))
					continue;

				let options = {};
				for (let k, v in s.options) {
					if (!match(k, BACKUP_NAME_RE))
						return { result: false, error: 'illegal option name' };

					if (type(v) === 'array') {
						v = map(v, (e) => sprintf('%s', e));
						if (!length(v))
							continue;
					} else if (type(v) in ['string', 'int', 'double', 'bool'])
						v = (type(v) === 'bool') ? (v ? '1' : '0') : sprintf('%s', v);
					else
						return { result: false, error: 'illegal option value' };

					options[k] = v;
				}

				push(sections, { name: s.name, type: s.type, options });
			}

			if (!length(sections))
				return { result: false, error: 'no usable section found' };

			const uci = cursor();
			uci.load('homeproxy');

			let node_names = {};
			let to_delete = [];

			uci.foreach('homeproxy', null, (s) => {
				const name = s['.name'], sectype = s['.type'];

				if (sectype === 'node')
					node_names[name] = true;
				if (name in BACKUP_SKIP)
					return;
				if (!import_nodes && backupIsNodeSection(name, sectype))
					return;

				push(to_delete, name);
			});

			if (!import_nodes) {
				/* The file's own nodes are not imported either */
				for (let s in backup.sections)
					if (s.type === 'node')
						node_names[s.name] = true;
				for (let s in sections)
					backupStripNodeRefs(s, node_names);
			}

			for (let name in to_delete)
				uci.delete('homeproxy', name);

			for (let s in sections) {
				uci.set('homeproxy', s.name, s.type);
				for (let k, v in s.options)
					uci.set('homeproxy', s.name, k, v);
			}

			uci.commit('homeproxy');

			return { result: true, sections: length(sections), include_nodes: import_nodes };
		}
	},

	connection_check: {
		args: { site: 'site' },
		call: function(req) {
			let url;
			switch(req.args?.site) {
			case 'baidu':
				url = 'https://www.baidu.com';
				break;
			case 'google':
				url = 'https://www.google.com';
				break;
			default:
				return { result: false, error: 'illegal site' };
				break;
			}

			return { result: (system(`/usr/bin/wget --spider -qT3 ${url} 2>"/dev/null"`, 3100) === 0) };
		}
	},

	log_clean: {
		args: { type: 'type' },
		call: function(req) {
			if (!(req.args?.type in ['homeproxy', 'sing-box-c', 'sing-box-s']))
				return { result: false, error: 'illegal type' };

			const filestat = lstat(`${RUN_DIR}/${req.args?.type}.log`);
			if (filestat)
				writefile(`${RUN_DIR}/${req.args?.type}.log`, '');
			return { result: true };
		}
	},

	singbox_generator: {
		args: { type: 'type', params: 'params' },
		call: function(req) {
			if (!(req.args?.type in ['ech-keypair', 'uuid', 'reality-keypair', 'vapid-keypair', 'wg-keypair']))
				return { result: false, error: 'illegal type' };

			const type = req.args?.type;
			let result = {};

			const fd = popen(`/usr/bin/sing-box generate ${type} ${shellquote(req.args?.params || '')}`);
			if (fd) {
				let ech_cfg_set = false;
				let ech_key_set = false;

				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (type === 'uuid')
						result.uuid = trim(line);
					else if (type in ['reality-keypair', 'vapid-keypair', 'wg-keypair']) {
						let priv = match(trim(line), /PrivateKey: (.*)/);
						if (priv)
							result.private_key = priv[1];
						let pub = match(trim(line), /PublicKey: (.*)/);
						if (pub)
							result.public_key = pub[1];
					} else if (type in ['ech-keypair']) {
						if (trim(line) === '-----BEGIN ECH CONFIGS-----')
							ech_cfg_set = true;
						else if (trim(line) === '-----BEGIN ECH KEYS-----')
							ech_key_set = true;

						if (ech_cfg_set)
							result.ech_cfg = result.ech_cfg ? result.ech_cfg + '\n' + trim(line) : trim(line) ;
						if (ech_key_set)
							result.ech_key = result.ech_key ? result.ech_key + '\n' + trim(line) : trim(line) ;

						if (trim(line) === '-----END ECH CONFIGS-----')
							ech_cfg_set = false;
						else if (trim(line) === '-----END ECH KEYS-----')
							ech_key_set = false;
					}
				}

				fd.close();
			}

			return { result };
		}
	},

	singbox_get_features: {
		call: function() {
			let features = {};

			const fd = popen('/usr/bin/sing-box version');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (match(trim(line), /^sing-box version (.*)/))
						features.version = match(trim(line), /^sing-box version (.*)/)[1];

					let tags = match(trim(line), /^Tags: (.*)/);
					if (tags)
						for (let i in split(tags[1], ','))
							features[i] = true;
				}

				fd.close();
			}

			features.hp_has_ip_full = access('/usr/libexec/ip-full');
			features.hp_has_tcp_brutal = hasKernelModule('brutal.ko');
			features.hp_has_tproxy = hasKernelModule('nft_tproxy.ko') || access('/etc/modules.d/nft-tproxy');
			features.hp_has_tun = hasKernelModule('tun.ko') || access('/etc/modules.d/30-tun');

			return features;
		}
	},

	resources_get_version: {
		args: { type: 'type' },
		call: function(req) {
			/* whitelist resource types to prevent path traversal */
			if (index(RESOURCE_TYPES, req.args?.type) === -1)
				return { error: 'illegal type', version: null };
			let version = trim(readfile(`${HP_DIR}/resources/${req.args?.type}.ver`));
			const fields = version ? match(version, /^(\S+) (\S+)$/) : null;
			if (fields)
				version = fields[1];
			return { version: version, error: error() };
		}
	},
	resources_update: {
		args: { type: 'type' },
		call: function(req) {
			if (index(RESOURCE_TYPES, req.args?.type) === -1)
				return { status: 255, error: 'illegal type' };
			if (req.args?.type) {
				const type = shellquote(req.args?.type);
				const exit_code = system(`${HP_DIR}/scripts/update_resources.sh ${type}`);
				return { status: exit_code };
			} else
				return { status: 255, error: 'illegal type' };
		}
	}
};

return { 'luci.homeproxy': methods };
