USE_PROCD=1

START=99
STOP=10

# refresh_lists re-applies the fw4 sets built from china_ip4/ip6.txt without
# restarting sing-box. It is called by update_crond.sh after a resource
# update, because a list update on disk has no effect until the firewall side
# is regenerated.
EXTRA_COMMANDS="refresh_lists"
EXTRA_HELP="	refresh_lists	Re-apply the updated resource lists (fw4)"

CONF="homeproxy"
PROG="/usr/bin/sing-box"

HP_DIR="/etc/homeproxy"
RUN_DIR="/var/run/homeproxy"
KILLSWITCH="$HP_DIR/scripts/killswitch.sh"
LOG_PATH="$RUN_DIR/homeproxy.log"
DASHBOARD_DIR="$RUN_DIR/dashboard"

# fw4 chain/set inventory; single source of truth shared with firewall_post.ut
[ -f "$HP_DIR/scripts/fw4_names.sh" ] && . "$HP_DIR/scripts/fw4_names.sh"
. "$HP_DIR/scripts/defaults.sh"

log() {
	# The log file lives in tmpfs, so it does not exist yet on the first start
	# (or right after a reboot) while the earliest diagnostics - missing
	# sing-box, unsupported version, no node configured - are already being
	# written. Create the directory here so those lines are not lost.
	mkdir -p "$RUN_DIR" 2>"/dev/null"
	echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

# Locate the directory dnsmasq reads the homeproxy snippets from. The UCI
# section name of the dnsmasq config is part of /tmp/etc/dnsmasq.conf.<name>,
# but `uci get` cannot return a section name (there is no `__name__`), so it is
# derived from the first `uci show` line. Either step can fail on an unusual
# setup; fall back to the generic directory and say so in the log instead of
# silently writing dnsmasq snippets nobody reads.
DNSMASQ_UCI_CONFIG="$(uci -q show "dhcp.@dnsmasq[0]" 2>"/dev/null" | head -n1)"
DNSMASQ_UCI_CONFIG="${DNSMASQ_UCI_CONFIG#*.}"
DNSMASQ_UCI_CONFIG="${DNSMASQ_UCI_CONFIG%%=*}"

DNSMASQ_DIR=""
if [ -n "$DNSMASQ_UCI_CONFIG" ] && [ -f "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG" ]; then
	DNSMASQ_CONF_DIR="$(awk -F '=' '/^conf-dir=/ {print $2; exit}' "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG")"
	[ -n "$DNSMASQ_CONF_DIR" ] && DNSMASQ_DIR="$DNSMASQ_CONF_DIR/dnsmasq-homeproxy.d"
fi

if [ -z "$DNSMASQ_DIR" ]; then
	log "WARNING: unable to derive the dnsmasq conf-dir (section '${DNSMASQ_UCI_CONFIG:-unknown}'), using /tmp/dnsmasq.d/dnsmasq-homeproxy.d; DNS-based routing will not take effect on setups where dnsmasq reads a different conf-dir."
	DNSMASQ_DIR="/tmp/dnsmasq.d/dnsmasq-homeproxy.d"
fi

restore_upnp_mappings() {
	[ -x /etc/init.d/miniupnpd ] && /etc/init.d/miniupnpd enabled && /etc/init.d/miniupnpd running \
		&& /etc/init.d/miniupnpd restart >"/dev/null" 2>&1
}

# Digest of the *.conf files in a directory, to tell whether a dnsmasq
# restart would change anything.
dns_snippets_digest() {
	local f
	for f in "$1"/*.conf; do
		[ -e "$f" ] || continue
		echo "== ${f##*/}"
		cat "$f"
	done | md5sum
}

# Render the dnsmasq snippet that hands every query to sing-box (the conf-dir
# include plus the redirect). Requires config_load to have run. The snippet
# is rendered aside and only swapped in (with a dnsmasq restart) when it
# differs from the live one: a reload for a node or rule change leaves it as
# it is.
render_dns_snippets() {
	local dns_port
	config_get dns_port "infra" "dns_port" "$HP_DEFAULT_DNS_PORT"

	local staging="$RUN_DIR/dnsmasq-staging"
	rm -rf "$staging"
	mkdir -p "$staging" || log "Warning: failed to create ${staging}."
	cat <<-EOF > "$staging/redirect-dns.conf"
		no-poll
		no-resolv
		server=127.0.0.1#$dns_port
	EOF

	if [ "$(cat "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" 2>"/dev/null")" = "conf-dir=$DNSMASQ_DIR" ] \
		&& [ "$(dns_snippets_digest "$staging")" = "$(dns_snippets_digest "$DNSMASQ_DIR")" ]; then
		rm -rf "$staging"
		return 0
	fi

	mkdir -p "$DNSMASQ_DIR" || log "Warning: failed to create ${DNSMASQ_DIR}."
	rm -f "$DNSMASQ_DIR"/*.conf 2>"/dev/null"
	mv "$staging"/*.conf "$DNSMASQ_DIR/" 2>"/dev/null" \
		|| log "Warning: failed to install the dnsmasq snippets."
	rm -rf "$staging"
	echo -e "conf-dir=$DNSMASQ_DIR" > "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" \
		|| log "Warning: failed to write the dnsmasq conf-dir file."

	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1 \
		|| log "Warning: failed to restart dnsmasq, DNS-based routing may be stale."
}

# Drop the dnsmasq snippets; dnsmasq is only restarted when there were any.
remove_dns_snippets() {
	[ -e "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" ] || [ -d "$DNSMASQ_DIR" ] || return 0

	rm -rf "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" "$DNSMASQ_DIR"
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1 \
		|| log "Warning: failed to restart dnsmasq after removing the homeproxy snippets."
}

# Keep the subscription auto-update entry in root's crontab in line with
# the wanted line (empty: no entry); cron is only restarted on a change.
sync_autoupdate_cron() {
	local want="$1"

	[ "$(grep "#${CONF}_autosetup" "/etc/crontabs/root" 2>"/dev/null")" != "$want" ] || return 0

	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null" \
		|| log "Warning: failed to drop the previous auto-update cron entry."
	if [ -n "$want" ]; then
		echo "$want" >> "/etc/crontabs/root" \
			|| log "Warning: failed to install the auto-update cron entry."
	fi
	/etc/init.d/cron restart >"/dev/null" 2>&1 || log "Warning: failed to restart cron."
}

fw4_snippets_digest() {
	local f
	for f in forward input post; do
		echo "== $f"
		cat "$RUN_DIR/fw4_$f.nft" 2>"/dev/null"
	done | md5sum
}

# Take every homeproxy rule and object out of fw4. The rules homeproxy adds to
# fw4's own chains (and the jumps into its chains) only go away with a reload
# on blank snippets; after that nothing references the homeproxy chains and
# sets any more, so a single nft batch removes them.
unload_firewall() {
	: > "$RUN_DIR/fw4_forward.nft"
	: > "$RUN_DIR/fw4_input.nft"
	: > "$RUN_DIR/fw4_post.nft"
	rm -f "$RUN_DIR/fw4_applied"
	fw4 reload >"/dev/null" 2>&1 || log "Warning: fw4 reload failed while unloading the homeproxy rules."
	hp_fw4_remove_all
}

# (Re)render the fw4 snippets and reload the firewall. The nft sets that carry
# the china address lists are built here from the resource files on disk, so
# this must run again after a resource update (refresh_lists) as well.
apply_firewall() {
	local outbound_node="$1"

	mkdir -p "$RUN_DIR" || { log "Error: failed to create ${RUN_DIR}."; return 1; }
	local old_digest="$(fw4_snippets_digest)"

	# Truncate first: firewall_pre.uc only writes a file when it has content,
	# so a server switch would otherwise keep the previous rules.
	: > "$RUN_DIR/fw4_forward.nft"
	: > "$RUN_DIR/fw4_input.nft"
	: > "$RUN_DIR/fw4_post.nft"

	ucode "$HP_DIR/scripts/firewall_pre.uc" 2>"/dev/null" || log "Error: firewall pre-script failed."
	if [ "$outbound_node" != "nil" ]; then
		utpl -S "$HP_DIR/scripts/firewall_post.ut" > "$RUN_DIR/fw4_post.nft" 2>"/dev/null" || log "Error: firewall post-script failed."
	fi

	# A node, DNS or routing rule change renders the same snippets; the fw4
	# reload (and the miniupnpd restart after it) would then change nothing.
	if [ "$(fw4_snippets_digest)" != "$old_digest" ] || [ ! -e "$RUN_DIR/fw4_applied" ] \
		|| ! hp_fw4_loaded "$RUN_DIR/fw4_post.nft"; then
		# fw4 only flushes its table on reload: a set keeps its elements and
		# a redefinition merges the new ones into them, so entries dropped
		# from a list (or a LAN ACL) would stay. Start from a clean table.
		if [ -n "$(hp_fw4_present)" ]; then
			local f
			for f in forward input post; do
				mv "$RUN_DIR/fw4_$f.nft" "$RUN_DIR/fw4_$f.nft.new"
			done
			unload_firewall
			for f in forward input post; do
				mv "$RUN_DIR/fw4_$f.nft.new" "$RUN_DIR/fw4_$f.nft"
			done
		fi

		if fw4 reload >"/dev/null" 2>&1; then
			: > "$RUN_DIR/fw4_applied"
		else
			log "Error: fw4 reload failed."
		fi
		restore_upnp_mappings
	fi

	# After fw4 reload on purpose: it keeps the armed/disarmed state of an
	# existing table, so a restart stays blocked until the guard sees sing-box.
	if killswitch_wanted; then
		"$KILLSWITCH" install || log "Warning: failed to install the kill switch."
	else
		"$KILLSWITCH" remove
	fi
}

# Outbound the client routes through ("nil" when the client is not
# configured); requires config_load. Without a single node there is nothing
# to route through yet (the template's groups would even be empty, which
# sing-box refuses), so the client counts as not configured.
client_outbound_node() {
	local node
	config_get node "routing" "default_outbound" "$HP_DEFAULT_DEFAULT_OUTBOUND"
	uci -q show "$CONF" | grep -q "^$CONF\.[^.]*=node\$" || node="nil"
	echo "$node"
}

# 0 when the kill switch is switched on and there is a client it can watch;
# requires config_load.
killswitch_wanted() {
	local kill_switch
	config_get_bool kill_switch "config" "kill_switch" "0"
	[ "$kill_switch" = "1" ] && [ "$(client_outbound_node)" != "nil" ]
}

# The inputs of what start_service sets up without comparing it first (it
# does compare the sing-box configs, fw4 / dnsmasq snippets and cron): the ip
# rules, the TUN device and the procd instance definitions (jail, mounts,
# env). While these stay the same, a reload only has to hand the running
# sing-box its new config. Requires config_load.
restart_fingerprint() {
	local proxy_mode ipv6_support dashboard server_enabled kill_switch
	local table_mark tproxy_mark tun_mark tun_name jail=0
	config_get proxy_mode "config" "proxy_mode" "$HP_DEFAULT_PROXY_MODE"
	config_get_bool ipv6_support "config" "ipv6_support" "0"
	config_get dashboard "config" "dashboard" "0"
	config_get_bool server_enabled "server" "enabled" "0"
	config_get_bool kill_switch "config" "kill_switch" "0"
	config_get table_mark "infra" "table_mark" "$HP_DEFAULT_TABLE_MARK"
	config_get tproxy_mark "infra" "tproxy_mark" "$HP_DEFAULT_TPROXY_MARK"
	config_get tun_mark "infra" "tun_mark" "$HP_DEFAULT_TUN_MARK"
	config_get tun_name "infra" "tun_name" "$HP_DEFAULT_TUN_NAME"
	[ -x "/sbin/ujail" ] && jail=1
	grep -Eq '"type": "(wireguard|tun)"' "$RUN_DIR/sing-box-c.json" 2>"/dev/null" && jail="$jail-off"
	local client=on
	[ "$(client_outbound_node)" != "nil" ] || client=off

	echo "$proxy_mode client=$client ipv6=$ipv6_support" \
		"dashboard=$dashboard server=$server_enabled ks=$kill_switch" \
		"marks=$table_mark/$tproxy_mark/$tun_mark tun=$tun_name jail=$jail kernel=$(uname -r)"
}

instance_pid() {
	ubus call service list "{\"name\":\"$CONF\"}" 2>"/dev/null" \
		| jsonfilter -e "@['$CONF'].instances['$1'].pid" 2>"/dev/null"
}

# `restart` is stop + start, but the kill switch has to tell it apart from a
# plain stop (which lifts the block), so leave a note for stop_service.
# HP_RESTARTING also tells stop_service to leave the firewall, dnsmasq and
# cron to start_service, which only touches what actually changed.
# rc.common's start does not pass on the status of start_service; a start
# that gave up has removed the fingerprint, so that is what tells (the LuCI
# restart button shows a failure by the exit code).
restart() {
	mkdir -p "$RUN_DIR"
	: > "$RUN_DIR/ks_restarting"
	HP_RESTARTING=1
	trap '' TERM
	stop "$@"
	start "$@"
	trap TERM
	[ -e "$RUN_DIR/restart.fingerprint" ]
}

# What a plain stop takes down besides the sing-box instances.
teardown_network() {
	rm -f "$RUN_DIR/restart.fingerprint"
	sync_autoupdate_cron ""
	unload_firewall
	restore_upnp_mappings
	remove_dns_snippets
}

start_service() {
	start_homeproxy "$@" && return 0

	# Across a restart the firewall and dnsmasq were left in place by
	# stop_service; a start that gives up must not keep steering traffic at
	# a sing-box that is not coming back.
	[ -z "$HP_RESTARTING$HP_INPLACE" ] || teardown_network
	return 1
}

# Sets sb_ver (a local of the caller) to the installed sing-box version;
# fails unless it is at least 1.14.
check_singbox_version() {
	local sb_major sb_minor
	sb_ver="$(sing-box version -n 2>/dev/null)"
	if [ -z "$sb_ver" ]; then
		log "Error: cannot detect sing-box version, abort."
		return 1
	fi
	sb_major="${sb_ver%%.*}"
	sb_minor="${sb_ver#*.}"
	sb_minor="${sb_minor%%.*}"
	if [ "$sb_major" -lt 1 ] || { [ "$sb_major" -eq 1 ] && [ "$sb_minor" -lt 14 ]; }; then
		log "Error: sing-box >= 1.14.0 required, found ${sb_ver}."
		return 1
	fi
}

wait_for_wan() {
	local wan_waited=0
	while ! { ip route show default 2>"/dev/null" | grep -q . \
		|| ip -6 route show default 2>"/dev/null" | grep -q . \
		|| ifstatus wan 2>"/dev/null" | grep -q '"up": true'; }; do
		wan_waited=$((wan_waited + 1))
		if [ "$wan_waited" -ge 60 ]; then
			log "WARNING: No network route after 60s, starting sing-box anyway."
			break
		fi
		sleep 1
	done
}

# The ip rules (tproxy) or the TUN device and its routes of the client.
# A reload in place keeps them: what they are built from is part of the
# restart fingerprint, which matched. Requires config_load.
setup_client_routing() {
	local proxy_mode="$1" ipv6_support="$2"

	[ -z "$HP_INPLACE" ] || return 0

	local table_mark
	config_get table_mark "infra" "table_mark" "$HP_DEFAULT_TABLE_MARK"
	case "$proxy_mode" in
	"redirect_tproxy")
		local tproxy_mark
		config_get tproxy_mark "infra" "tproxy_mark" "$HP_DEFAULT_TPROXY_MARK"

		ip rule add fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null" \
			|| log "Error: failed to add the tproxy ip rule (fwmark ${tproxy_mark}, table ${table_mark})."
		ip route add local 0.0.0.0/0 dev lo table "$table_mark" 2>"/dev/null" \
			|| log "Error: failed to add the tproxy local route (table ${table_mark})."

		if [ "$ipv6_support" -eq "1" ]; then
			ip -6 rule add fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null" \
				|| log "Error: failed to add the tproxy IPv6 rule (fwmark ${tproxy_mark}, table ${table_mark})."
			ip -6 route add local ::/0 dev lo table "$table_mark" 2>"/dev/null" \
				|| log "Error: failed to add the tproxy IPv6 local route (table ${table_mark})."
		fi
		;;
	"redirect_tun"|"tun")
		local tun_name tun_mark
		config_get tun_name "infra" "tun_name" "$HP_DEFAULT_TUN_NAME"
		config_get tun_mark "infra" "tun_mark" "$HP_DEFAULT_TUN_MARK"

		ip tuntap add mode tun user root name "$tun_name" 2>"/dev/null" \
			|| log "Error: failed to create the TUN device ${tun_name}."
		sleep 1s
		ip link set "$tun_name" up 2>"/dev/null" \
			|| log "Error: failed to bring up the TUN device ${tun_name}."

		ip route replace default dev "$tun_name" table "$table_mark" 2>"/dev/null" \
			|| log "Error: failed to set the TUN default route (table ${table_mark})."
		ip rule add fwmark "$tun_mark" lookup "$table_mark" 2>"/dev/null" \
			|| log "Error: failed to add the TUN ip rule (fwmark ${tun_mark}, table ${table_mark})."

		if [ "$ipv6_support" -eq "1" ]; then
			ip -6 route replace default dev "$tun_name" table "$table_mark" 2>"/dev/null" \
				|| log "Error: failed to set the TUN IPv6 default route (table ${table_mark})."
			ip -6 rule add fwmark "$tun_mark" lookup "$table_mark" 2>"/dev/null" \
				|| log "Error: failed to add the TUN IPv6 rule (fwmark ${tun_mark}, table ${table_mark})."
		fi
		;;
	esac
}

# Limits, logging and respawn shared by the sing-box instances.
close_singbox_instance() {
	procd_set_param limits core="0"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stderr 1
	procd_set_param respawn

	procd_close_instance
}

add_client_instance() {
	local dashboard="$1" disable_gso="$2"

	procd_open_instance "sing-box-c"

	procd_set_param command "$PROG"
	procd_append_param command run --config "$RUN_DIR/sing-box-c.json"

	[ "$disable_gso" -eq "1" ] && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
	[ "$dashboard" = "1" ] && procd_append_param env "TMPDIR=$DASHBOARD_DIR/tmp"

	if [ -x "/sbin/ujail" ] && ! grep -Eq '"type": "(wireguard|tun)"' "$RUN_DIR/sing-box-c.json"; then
		procd_add_jail "sing-box-c" log procfs
		procd_add_jail_mount "$RUN_DIR/sing-box-c.json"
		procd_add_jail_mount_rw "$RUN_DIR/sing-box-c.log"
		# A local rule-set may point at any path under HP_DIR, so the
		# whole directory goes in read-only. procd orders the mounts by
		# path, so this parent cannot shadow the read-write cache.db below.
		procd_add_jail_mount "$HP_DIR/"
		procd_add_jail_mount_rw "$HP_DIR/cache.db"
		[ "$dashboard" = "1" ] && procd_add_jail_mount_rw "$DASHBOARD_DIR/"
		procd_add_jail_mount "$HP_DIR/certs/"
		procd_add_jail_mount "/etc/acme/"
		procd_add_jail_mount "/etc/ssl/"
		# find_neighbor reads LAN hostnames from the dnsmasq lease file.
		procd_add_jail_mount "/tmp/dhcp.leases"
		procd_add_jail_mount "/etc/localtime"
		procd_add_jail_mount "/etc/TZ"
		procd_set_param capabilities "/etc/capabilities/homeproxy.json"
		procd_set_param no_new_privs 1
		procd_set_param user sing-box
		procd_set_param group sing-box
	elif [ ! -x "/sbin/ujail" ]; then
		log "Warning: /sbin/ujail is missing; sing-box client runs as root without a jail."
	fi

	close_singbox_instance
}

# Generate the client config, then set up everything around it and register
# the instance. Requires config_load.
start_client() {
	local proxy_mode="$1" ipv6_support="$2" dashboard="$3" disable_gso="$4"

	wait_for_wan

	# Judge by the generator's exit code, not by the file: the generator
	# keeps the previous sing-box-c.json when it fails, so an existing file
	# only proves that some older config is valid - the service would then
	# silently keep running the old nodes/routing while reporting success.
	# The generator runs `sing-box check` itself before it moves the file
	# into place. A reload has generated it already (HP_CLIENT_READY).
	if [ -z "$HP_CLIENT_READY" ] && ! ucode -S "$HP_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH"; then
		log "Error: failed to generate client configuration."
		return 1
	fi

	if [ ! -e "$RUN_DIR/sing-box-c.json" ]; then
		log "Error: client configuration was not generated."
		return 1
	fi

	local auto_update auto_update_time autoupdate_cron
	config_get_bool auto_update "subscription" "auto_update" "0"
	if [ "$auto_update" = "1" ]; then
		config_get auto_update_time "subscription" "auto_update_time" "$HP_DEFAULT_AUTO_UPDATE_TIME"
		autoupdate_cron="0 $auto_update_time * * * $HP_DIR/scripts/update_crond.sh #${CONF}_autosetup"
	fi
	sync_autoupdate_cron "$autoupdate_cron"

	render_dns_snippets
	setup_client_routing "$proxy_mode" "$ipv6_support"
	add_client_instance "$dashboard" "$disable_gso"
}

start_server() {
	local disable_gso="$1"

	if [ -z "$HP_SERVER_READY" ] && ! ucode -S "$HP_DIR/scripts/generate_server.uc" 2>>"$LOG_PATH"; then
		log "Error: failed to generate server configuration."
		return 1
	fi

	if [ ! -e "$RUN_DIR/sing-box-s.json" ]; then
		log "Error: server configuration was not generated."
		return 1
	fi

	procd_open_instance "sing-box-s"

	procd_set_param command "$PROG"
	procd_append_param command run --config "$RUN_DIR/sing-box-s.json"

	[ "$disable_gso" -eq "1" ] && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"

	if [ -x "/sbin/ujail" ]; then
		procd_add_jail "sing-box-s" log procfs
		procd_add_jail_mount "$RUN_DIR/sing-box-s.json"
		procd_add_jail_mount_rw "$RUN_DIR/sing-box-s.log"
		procd_add_jail_mount_rw "$HP_DIR/certs/"
		procd_add_jail_mount "/etc/acme/"
		procd_add_jail_mount "/etc/ssl/"
		procd_add_jail_mount "/etc/localtime"
		procd_add_jail_mount "/etc/TZ"
		procd_set_param capabilities "/etc/capabilities/homeproxy.json"
		procd_set_param no_new_privs 1
		procd_set_param user sing-box
		procd_set_param group sing-box
	fi

	close_singbox_instance
}

# The log cleaner, and the kill switch guard, which blocks overseas traffic
# whenever the client is not running (crash, reload, restart, failed start).
# The hold file of a restart ends here: from now on only a running sing-box
# lifts the block.
add_helper_instances() {
	procd_open_instance "log-cleaner"
	procd_set_param command "$HP_DIR/scripts/clean_log.sh"
	procd_set_param respawn
	procd_close_instance

	rm -f "$RUN_DIR/ks_hold"
	if killswitch_wanted; then
		procd_open_instance "killswitch-guard"
		procd_set_param command "$KILLSWITCH" guard
		procd_set_param respawn
		procd_close_instance
	fi
}

# Files and directories the jailed sing-box (user sing-box) reads or writes.
prepare_runtime_files() {
	local outbound_node="$1" server_enabled="$2" dashboard="$3"

	# The file has to exist before the client jail binds it read-write.
	[ -e "$HP_DIR/cache.db" ] || touch "$HP_DIR/cache.db" \
		|| log "Warning: failed to create ${HP_DIR}/cache.db."
	[ -d "$HP_DIR/ruleset" ] || mkdir -p "$HP_DIR/ruleset" \
		|| log "Warning: failed to create ${HP_DIR}/ruleset."
	# A local rule-set is opened by the client, which is jailed and no longer
	# root, so the documented directory has to be readable by it.
	chown -R sing-box:sing-box "$HP_DIR/ruleset" 2>"/dev/null" \
		|| log "Warning: failed to hand ${HP_DIR}/ruleset to sing-box."

	# The jailed client has no writable /tmp, and the flash overlay is often too
	# small for the dashboard, so it lives in RAM under RUN_DIR (re-downloaded
	# after a reboot). The archive and the unpacked files share one read-write
	# mount so that sing-box never has to rename across filesystems.
	rm -rf "$HP_DIR/dashboard"
	if [ "$dashboard" = "1" ] && [ "$outbound_node" != "nil" ]; then
		mkdir -p "$DASHBOARD_DIR/tmp" \
			&& chown -R sing-box:sing-box "$DASHBOARD_DIR" 2>"/dev/null" \
			|| log "Warning: failed to prepare ${DASHBOARD_DIR} for sing-box."
	fi

	[ "$outbound_node" = "nil" ] || echo > "$RUN_DIR/sing-box-c.log"
	if [ "$server_enabled" = "1" ]; then
		echo > "$RUN_DIR/sing-box-s.log"
		mkdir -p "$HP_DIR/certs" || log "Warning: failed to create ${HP_DIR}/certs."
	fi

	# chown only what is actually there: a server-only setup has no client
	# config or log, which is not an error worth logging on every start.
	local hp_file
	for hp_file in "$RUN_DIR"/sing-box-*.json "$RUN_DIR"/sing-box-*.log "$HP_DIR"/cache.db; do
		[ -e "$hp_file" ] || continue
		chown sing-box:sing-box "$hp_file" 2>"/dev/null" \
			|| log "Warning: failed to change the ownership of ${hp_file}."
	done
	# the generated client config carries every node credential
	[ -e "$RUN_DIR/sing-box-c.json" ] && chmod 600 "$RUN_DIR/sing-box-c.json" 2>"/dev/null"
	[ -e "$RUN_DIR/sing-box-s.json" ] && chmod 600 "$RUN_DIR/sing-box-s.json" 2>"/dev/null"
}

start_homeproxy() {
	config_load "$CONF"

	local sb_ver
	check_singbox_version || return 1

	local proxy_mode ipv6_support
	config_get proxy_mode "config" "proxy_mode" "$HP_DEFAULT_PROXY_MODE"
	config_get_bool ipv6_support "config" "ipv6_support" "0"

	local outbound_node="$(client_outbound_node)"

	local server_enabled dashboard
	config_get_bool server_enabled "server" "enabled" "0"
	config_get dashboard "config" "dashboard" "0"

	if [ "$outbound_node" = "nil" ] && [ "$server_enabled" = "0" ]; then
		log "Neither client (a default outbound and at least one node) nor server is configured. Service not started."
		return 1
	fi

	mkdir -p "$RUN_DIR"

	local disable_gso=0
	uname -r | grep -Eq "^6\.6" && disable_gso=1

	if [ "$outbound_node" != "nil" ]; then
		start_client "$proxy_mode" "$ipv6_support" "$dashboard" "$disable_gso" || return 1
	else
		# server only: what a restart left behind from the client goes now
		sync_autoupdate_cron ""
		remove_dns_snippets
	fi

	if [ "$server_enabled" = "1" ]; then
		start_server "$disable_gso" || return 1
	fi

	add_helper_instances
	prepare_runtime_files "$outbound_node" "$server_enabled" "$dashboard"

	apply_firewall "$outbound_node"
	restart_fingerprint > "$RUN_DIR/restart.fingerprint"

	log "sing-box ${sb_ver} started."
}

stop_service() {
	config_load "$CONF"

	# A restart/reload keeps the kill switch armed through the gap, anything
	# else (stop, disable, shutdown) lifts it. The hold file stops a still
	# running guard from disarming while the firewall is being torn down.
	if [ -e "$RUN_DIR/ks_restarting" ]; then
		rm -f "$RUN_DIR/ks_restarting"
		if killswitch_wanted; then
			: > "$RUN_DIR/ks_hold"
			"$KILLSWITCH" arm || log "Warning: failed to arm the kill switch."
		else
			"$KILLSWITCH" remove
		fi
	else
		rm -f "$RUN_DIR/ks_hold"
		"$KILLSWITCH" remove
	fi

	local table_mark tproxy_mark tun_mark tun_name
	config_get table_mark "infra" "table_mark" "$HP_DEFAULT_TABLE_MARK"
	config_get tproxy_mark "infra" "tproxy_mark" "$HP_DEFAULT_TPROXY_MARK"
	config_get tun_mark "infra" "tun_mark" "$HP_DEFAULT_TUN_MARK"
	config_get tun_name "infra" "tun_name" "$HP_DEFAULT_TUN_NAME"

	# ip rule del removes a single matching rule, so a repeated start (or an
	# upgrade that starts before the old instance stopped) leaves duplicates
	# behind. Delete every match instead of only the first one.
	while ip rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"; do :; done
	ip route del local 0.0.0.0/0 dev lo table "$table_mark" 2>"/dev/null"
	while ip -6 rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"; do :; done
	ip -6 route del local ::/0 dev lo table "$table_mark" 2>"/dev/null"

	ip route del default dev "$tun_name" table "$table_mark" 2>"/dev/null"
	while ip rule del fwmark "$tun_mark" table "$table_mark" 2>"/dev/null"; do :; done

	ip -6 route del default dev "$tun_name" table "$table_mark" 2>"/dev/null"
	while ip -6 rule del fwmark "$tun_mark" table "$table_mark" 2>"/dev/null"; do :; done

	# A restart/reload goes straight on to start_service, which reloads fw4,
	# restarts dnsmasq or touches cron only when their rendered content
	# changed. Tearing them down here would cost two fw4 reloads and dnsmasq
	# restarts per reload even when only a node changed. The generated
	# configs stay as well: a reload has already produced the new ones.
	if [ -z "$HP_RESTARTING" ]; then
		teardown_network
		rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-c.log" \
			"$RUN_DIR/sing-box-s.json" "$RUN_DIR/sing-box-s.log"
	fi

	log "Service stopped."
}

service_stopped() {
	config_load "$CONF"
	local tun_name
	config_get tun_name "infra" "tun_name" "$HP_DEFAULT_TUN_NAME"

	ip link set "$tun_name" down 2>"/dev/null"
	ip tuntap del mode tun name "$tun_name" 2>"/dev/null"
}

reload_service() {
	log "Reloading service..."

	config_load "$CONF"
	local outbound_node="$(client_outbound_node)"

	local old_client old_server
	old_client="$(md5sum < "$RUN_DIR/sing-box-c.json" 2>"/dev/null")"
	old_server="$(md5sum < "$RUN_DIR/sing-box-s.json" 2>"/dev/null")"

	# The generators run `sing-box check` before they replace the config, so
	# a failure leaves the running service untouched. start_service reuses
	# what is generated here instead of generating and checking it again.
	if [ "$outbound_node" != "nil" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH"; then
			log "Error: failed to generate client configuration, reload aborted."
			return 1
		fi
		HP_CLIENT_READY=1
	fi

	local server_enabled
	config_get_bool server_enabled "server" "enabled" "0"
	if [ "$server_enabled" = "1" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_server.uc" 2>>"$LOG_PATH"; then
			log "Error: failed to generate server configuration, reload aborted."
			return 1
		fi
		HP_SERVER_READY=1
	fi

	# Nothing but the sing-box configs (and maybe the fw4 / dnsmasq snippets,
	# which start_service compares itself) changed: keep sing-box running and
	# let it reload the new config on SIGHUP. It checks the config first and
	# keeps the old one on error. No stop, so no gap without firewall rules
	# and no restarted process.
	if [ "$(restart_fingerprint)" = "$(cat "$RUN_DIR/restart.fingerprint" 2>"/dev/null")" ]; then
		local client_pid server_pid
		client_pid="$(instance_pid sing-box-c)"
		server_pid="$(instance_pid sing-box-s)"
		if { [ "$outbound_node" = "nil" ] || [ -n "$client_pid" ]; } \
			&& { [ "$server_enabled" = "0" ] || [ -n "$server_pid" ]; }; then
			HP_INPLACE=1
			start
			if [ ! -e "$RUN_DIR/restart.fingerprint" ]; then
				log "Error: in-place reload failed, service stopped."
				return 1
			fi

			# Only to the process that was already running: a restarted one
			# (new pid) has read the new config, and a SIGHUP that lands before
			# it set up its handler would kill it.
			if [ -n "$client_pid" ] && [ "$(instance_pid sing-box-c)" = "$client_pid" ] \
				&& [ "$(md5sum < "$RUN_DIR/sing-box-c.json")" != "$old_client" ]; then
				procd_send_signal "$CONF" "sing-box-c" HUP
			fi
			if [ -n "$server_pid" ] && [ "$(instance_pid sing-box-s)" = "$server_pid" ] \
				&& [ "$(md5sum < "$RUN_DIR/sing-box-s.json")" != "$old_server" ]; then
				procd_send_signal "$CONF" "sing-box-s" HUP
			fi
			log "Service reloaded in place."
			return 0
		fi
	fi

	# only now: an aborted reload must not leave the note behind
	mkdir -p "$RUN_DIR"
	: > "$RUN_DIR/ks_restarting"
	HP_RESTARTING=1
	stop
	start
}

# Re-apply the resource lists that were refreshed on disk (called by
# update_crond.sh). Only the firewall sets depend on those files, so sing-box
# itself is left running.
refresh_lists() {
	config_load "$CONF"

	local outbound_node="$(client_outbound_node)"
	[ "$outbound_node" != "nil" ] || return 0

	apply_firewall "$outbound_node"

	log "Resource list changes applied (fw4 sets)."
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}
